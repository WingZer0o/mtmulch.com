# Copy to secrets.env (gitignored) or let deploy-local.sh generate it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@postgres:5432/rust_playground
# 32 random bytes as 64 hex chars:  openssl rand -hex 32
PASETO_SECRET_KEY=
BLOB_ENCRYPTION_KEY=
# A placeholder works; emails will fail to send and be logged by the API.
RESEND_API_KEY=re_local_placeholder
